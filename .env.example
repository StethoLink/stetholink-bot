# Copy to .env.local for local development. Placeholders only: never commit real values or patient data.
# Variables prefixed NEXT_PUBLIC_ reach the browser; never put secrets in them.

# Frontend: "mock" uses the synthetic in-browser client, "http" calls /api/*
NEXT_PUBLIC_API_MODE=mock

# AI provider: mock | openai
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Auth: dev (synthetic clinician, non-production only) | supabase
AUTH_MODE=dev

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clinical data source: synthetic | fhir
CLINICAL_DATA_SOURCE=synthetic
FHIR_BASE_URL=
SMART_CLIENT_ID=
