# Copy to apps/embedded-app/.env.local for the local synthetic chart.
NEXT_PUBLIC_API_MODE=http
AUTH_MODE=dev
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
TENANT_ID=local-synthetic
CLINICAL_DATA_SOURCE=synthetic
MOCK_RECIPIENT_IDS=synthetic-consult-team

# Server-only restricted PostgreSQL connection for SMART or staging.
STETHOLINK_DATABASE_URL=
STETHOLINK_DATABASE_CA=

# Vercel Preview only. Set AUTH_MODE=staging and retain synthetic data and the mock model.
STAGING_LAUNCH_SECRET=
STAGING_SESSION_SECONDS=300

# SMART read-only launch. Set AUTH_MODE=smart and CLINICAL_DATA_SOURCE=fhir or openemr.
FHIR_BASE_URL=
SMART_CLIENT_ID=
SMART_AUTHORIZATION_URL=
SMART_TOKEN_URL=
SMART_REDIRECT_URI=
SMART_OIDC_ISSUER=
SMART_JWKS_URL=
SMART_SCOPE=
SMART_CLINICIAN_MAP=
