# Copy to apps/embedded-app/.env.local for local development.
# NEXT_PUBLIC_* values are visible to the browser.
NEXT_PUBLIC_API_MODE=http
AUTH_MODE=dev
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
TENANT_ID=local-synthetic
CLINICAL_DATA_SOURCE=synthetic
MOCK_RECIPIENT_IDS=synthetic-consult-team

# Optional dedicated Supabase tenant
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional read-only SMART sandbox. Use HTTPS and trusted issuer endpoints.
FHIR_BASE_URL=
SMART_CLIENT_ID=
SMART_AUTHORIZATION_URL=
SMART_TOKEN_URL=
SMART_REDIRECT_URI=
SMART_SCOPE=
