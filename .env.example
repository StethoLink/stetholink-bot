# Copy to apps/embedded-app/.env.local for the local synthetic chart.
NEXT_PUBLIC_API_MODE=http
AUTH_MODE=dev
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
TENANT_ID=local-synthetic
CLINICAL_DATA_SOURCE=synthetic
# Tenant allowlist of synthetic providers (enforced in Core and in PostgreSQL).
MOCK_RECIPIENT_IDS=synthetic-cardiology,synthetic-cardiology-declines,synthetic-cardiology-offline,synthetic-radiology
# Local chart: alpha (default) or ahmed (fictional cardiology case used by npm run demo).
LOCAL_SYNTHETIC_CHART=alpha

# Server-only restricted PostgreSQL connection for SMART or staging.
STETHOLINK_DATABASE_URL=
STETHOLINK_DATABASE_CA=

# Vercel Preview only. Set AUTH_MODE=staging and retain synthetic data and the mock model.
STAGING_LAUNCH_SECRET=
STAGING_SESSION_SECONDS=300
# Optional 32+ character secret for synthetic provider callbacks (defaults to one derived from STAGING_LAUNCH_SECRET).
MOCK_PROVIDER_SECRET=

# SMART read-only launch. Set AUTH_MODE=smart and CLINICAL_DATA_SOURCE=fhir or openemr.
FHIR_BASE_URL=
SMART_CLIENT_ID=
SMART_AUTHORIZATION_URL=
SMART_TOKEN_URL=
SMART_REDIRECT_URI=
SMART_OIDC_ISSUER=
SMART_JWKS_URL=
SMART_SCOPE=
SMART_CLINICIAN_MAP=

# Optional server-side OpenAI controls (mock remains the default).
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=1
OPENAI_MAX_INPUT_TOKENS=16000
OPENAI_MAX_OUTPUT_TOKENS=2048
OPENAI_MAX_COST_USD=0.1
# Required for live calls: operator-verified upper-bound USD rates for OPENAI_MODEL.
# No pricing is assumed. Missing rates block OpenAI calls before network access.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
