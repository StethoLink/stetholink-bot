# Copy to apps/embedded-app/.env.local and fill in every value marked "required".
# StethoLink has one mode: a verified launch from a real EHR, the EHR's own chart, PostgreSQL and a real model.
# There are no built-in patients, no stand-in model and no simulated specialist. With a required value empty,
# the server exits at start and names the setting. These settings no longer exist and are refused if set:
#   AUTH_MODE=dev|staging|supabase, CLINICAL_DATA_SOURCE=synthetic, CLINICAL_DATA_MODE=synthetic, AI_PROVIDER=mock,
#   TRANSCRIPTION_PROVIDER=mock, NEXT_PUBLIC_API_MODE=mock, STAGING_LAUNCH_SECRET, STAGING_SESSION_SECONDS,
#   STAGING_LIVE_MODEL, MOCK_RECIPIENT_IDS, MOCK_PROVIDER_SECRET, LOCAL_SYNTHETIC_CHART.
# Required: the tenant (one hospital per deployment).
TENANT_ID=
# Required: where the chart is read from: fhir or openemr.
CLINICAL_DATA_SOURCE=
# Required: the model key (server side only).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Optional base URL of the Responses API, for a regional or self-hosted deployment. HTTPS only
# (plain HTTP is accepted for a loopback address outside production).
OPENAI_BASE_URL=

# Required: server-only restricted PostgreSQL connection.
STETHOLINK_DATABASE_URL=
STETHOLINK_DATABASE_CA=

# Required: encrypts stored sessions, which hold the EHR access token. 32 random bytes, base64 (openssl rand -base64 32).
SESSION_ENCRYPTION_KEY=
SESSION_ENCRYPTION_KEYS_PREVIOUS=
# lax: top-level window. embedded: inside the EHR's iframe.
COOKIE_MODE=lax

# Required: SMART launch from the EHR (all nine values). It is the only sign-in. Check them with: npm run smart:preflight
# SMART_SCOPE must contain launch, openid and fhirUser, and read+search on the chart resources, e.g. (SMART v2):
#   launch openid fhirUser patient/Patient.rs patient/Encounter.rs patient/Condition.rs patient/MedicationRequest.rs
#   patient/AllergyIntolerance.rs patient/Observation.rs patient/Medication.rs
# Do not add launch/patient: it asks for standalone context, and OpenEMR then leaves the encounter out of an
# EHR launch. The server drops it from the launch request if it is present.
# (SMART v1 servers: the same resources with .read). A resource the EHR does not grant is shown to the
# clinician as "could not be loaded"; it never fails the chart.
# SMART_CLINICIAN_MAP is a JSON list of { subject, fhirUser, clinicianId (UUID), role: physician|clinician }.
# Every mapped clinician may draft; only a physician may approve and send. The EHR token grants nothing.
FHIR_BASE_URL=
SMART_CLIENT_ID=
SMART_AUTHORIZATION_URL=
SMART_TOKEN_URL=
SMART_REDIRECT_URI=
SMART_OIDC_ISSUER=
SMART_JWKS_URL=
SMART_SCOPE=
SMART_CLINICIAN_MAP=

# Consultation assistant: real model inference only. The key stays on the server.
# Required: MODEL_LIVE_DATA_APPROVED=true, the operator's statement that the vendor agreement and data residency
# cover the patients of the connected EHR. The server does not start without it.
MODEL_LIVE_DATA_APPROVED=false
# Total model spend allowed per server instance per UTC day, in addition to OPENAI_MAX_COST_USD per call.
AI_DAILY_BUDGET_USD=2
# Optional for reasoning models: minimal, low, medium or high.
OPENAI_REASONING_EFFORT=

# Optional server-side OpenAI controls.
OPENAI_TIMEOUT_MS=90000
OPENAI_MAX_RETRIES=1
OPENAI_MAX_INPUT_TOKENS=16000
OPENAI_MAX_OUTPUT_TOKENS=8000
OPENAI_MAX_COST_USD=0.25
# Required: operator-verified upper-bound USD rates for OPENAI_MODEL. No pricing is assumed.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=

# AI scribe (visit recording -> SOAP note). Off by default.
# The audio is never stored (SCRIBE_AUDIO_RETENTION accepts only "none"). The transcript is deleted when the
# note is written to the chart, or after SCRIBE_TRANSCRIPT_RETENTION_DAYS at the latest.
SCRIBE_ENABLED=false
SCRIBE_AUDIO_RETENTION=none
SCRIBE_TRANSCRIPT_RETENTION_DAYS=7
SCRIBE_SPOKEN_LANGUAGE=ar-SA
SCRIBE_NOTE_LANGUAGE=en
SCRIBE_MAX_VISIT_MINUTES=45
SCRIBE_MAX_VISIT_USD=0.5
# Speech to text: openai or elevenlabs. Chosen by measurement: docs/ai/scribe-benchmark.md.
# With SCRIBE_ENABLED=true these are required: an operator-verified price per audio minute, the note rates below
# and TRANSCRIPTION_LIVE_DATA_APPROVED=true (vendor agreement and region cover the patients' speech).
TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_MODEL=gpt-transcribe
TRANSCRIPTION_USD_PER_MINUTE=
TRANSCRIPTION_MAX_USD_PER_MINUTE=0.01
TRANSCRIPTION_LIVE_DATA_APPROVED=false
TRANSCRIPTION_BASE_URL=
ELEVENLABS_API_KEY=
# The note is written in one model call per visit by this (cheaper) model, with its own verified rates.
SCRIBE_NOTE_MODEL=gpt-5-mini
SCRIBE_NOTE_REASONING_EFFORT=low
SCRIBE_NOTE_INPUT_USD_PER_MILLION=
SCRIBE_NOTE_OUTPUT_USD_PER_MILLION=

# Writing to the EHR after physician approval: create only, never update or delete. Needs create scopes in
# SMART_SCOPE, e.g. patient/DocumentReference.c patient/AllergyIntolerance.c patient/Condition.c
# patient/MedicationStatement.c (SMART v1: the same resources with .write). A resource the EHR does not grant
# or support is offered to the physician as text to copy.
EHR_WRITE_ENABLED=false
# docStatus of a written note: preliminary lets the physician sign it in the EHR.
FHIR_NOTE_DOC_STATUS=preliminary
# LOINC code of the note type, if the hospital wants another than 11506-3 (Progress note).
FHIR_NOTE_TYPE_CODE=

# Receiving specialist services of the tenant (inbox inside the plugin). Without them nothing can be sent. JSON, server side only.
# PROVIDER_DIRECTORY=[{"id":"cardiology-service","displayName":"Cardiology consult service","specialties":["Cardiology"],"transport":"portal"}]
# PROVIDER_ALLOWLIST=cardiology-service
# Who may open each inbox: EHR identity (subject + fhirUser, for a SMART launch without a patient) and/or email.
# SPECIALIST_MAP=[{"specialistId":"<uuid>","providerId":"cardiology-service","displayName":"Dr ...","subject":"...","fhirUser":"Practitioner/..."}]
PROVIDER_DIRECTORY=
PROVIDER_ALLOWLIST=
SPECIALIST_MAP=
# One-time sign-in codes by email: none (off) or console (prints the code to the log; development only, refused in production).
EMAIL_PROVIDER=none
SPECIALIST_SESSION_MINUTES=30
