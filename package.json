{
  "name": "stetholink-bot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev apps/embedded-app",
    "build": "next build apps/embedded-app",
    "start": "next start apps/embedded-app",
    "lint": "eslint",
    "typecheck": "next typegen apps/embedded-app && tsc --noEmit",
    "test": "vitest run",
    "test:backend": "vitest run tests/backend",
    "test:frontend": "vitest run tests/frontend",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "jose": "6.2.17",
    "next": "15.5.29",
    "postgres": "3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.32"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
